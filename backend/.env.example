# ODSay API Configuration
# Get your API key from: https://lab.odsay.com/
ODSAY_API_KEY=your_odsay_api_key_here

# LLM Configuration (for route explanations)
# Choose provider: "openai", "gemini", or "mock"
LLM_PROVIDER=mock
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gpt-3.5-turbo

# Real-time Transit API (optional)
REALTIME_TRANSIT_API_KEY=your_realtime_api_key_here
USE_MOCK_REALTIME_DATA=true

# Database Configuration
DATABASE_URL=sqlite:///./app.db

# API Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME=안끼길 API
VERSION=1.0.0

# Route Optimization
COMFORT_ROUTE_MAX_TIME_DELTA=15

# CORS Configuration (comma-separated)
ALLOWED_ORIGINS=*

